<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Suite" parallel="methods" thread-count="5" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>

    <test name="UI Regression">
        <classes>
            <class name="com.tests.ui.SauceDemoE2ETest"/>
        </classes>
    </test>

    <test name="API Regression">
        <classes>
            <class name="com.tests.api.UserApiTest"/>
        </classes>
    </test>

</suite>
